  "conflict": {
    "doc": "docs/ages.md#conflict",
    "principle": "Fights are agent against agent and emerge from the simulation. They happen between civilisations AND inside one: a civilisation alone on its planet still has clans, rebels and lords who fight.",
    "escalation": [
      {
        "level": "scuffle",
        "who": "two agents",
        "from": "an insult, a rivalry, or competition for the same food or tile",
        "outcome": "wounds; a grudge between their families"
      },
      {
        "level": "feud",
        "who": "two families or clans",
        "from": "repeated scuffles or a death",
        "outcome": "ambushes, revenge, stolen goats"
      },
      {
        "level": "raid",
        "who": "a war band against a settlement",
        "from": "hunger, greed, aggressive traits",
        "outcome": "stolen food, burned buildings, captives"
      },
      {
        "level": "battle",
        "who": "two armies",
        "from": "a raid answered, or a border dispute",
        "outcome": "a won or lost field; morale swings"
      },
      {
        "level": "war",
        "who": "two civilisations or realms",
        "from": "several battles, or a declaration (ages 7+)",
        "outcome": "territory and settlements change hands; truce or conquest"
      },
      {
        "level": "civil_war",
        "who": "factions inside one civilisation",
        "from": "low stability plus inequality, faith schisms, succession disputes or revolutions",
        "outcome": "the civilisation splits into a new one, or the rebels are crushed"
      }
    ],
    "causes": [
      "hunger",
      "territory",
      "ore and resources",
      "inequality",
      "faith and schisms",
      "succession",
      "revenge and grudges",
      "the player's anger"
    ],
    "inside_one_civ": [
      "clan feuds (ages 1-6)",
      "succession splits (age 7+)",
      "province revolts (age 11+)",
      "peasant revolts and plague riots (age 12+)",
      "civil wars and revolutions (age 16+)",
      "misinformation riots (age 18+)"
    ],
    "battle": {
      "morale": "Each fighter has morale. Losses nearby, being outnumbered and wounded leaders lower it; at 0 they flee, and a rout can spread through the line.",
