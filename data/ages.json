      ]
    },
    "player": {
      "anger_or_pulse": "Raises aggression and pushes conflicts up the ladder.",
      "calm": "Lowers aggression; conflicts drift down toward a truce.",
      "peace_cast": "Forces a truce around the aim point.",
      "lightning": "Breaks a charge and scatters fighters; the struck side loses morale.",
